            {
              "name": "session_id",
              "value": "integration-test-v3-01"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Test: PII Masking & Knowledge Retrieval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8000/sessions/integration-test-v3-01/history",
        "options": {}
      },
      "id": "3",
      "name": "Verify: History & Masking",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"history\"].join(\" \")}}",
              "operation": "notContains",
              "value2": "John Doe"
            },
            {
              "value1": "={{$json[\"history\"].join(\" \")}}",
              "operation": "contains",
              "value2": "[NAME_HIDDEN]"
            }
          ]
        }
      },
      "id": "4",
      "name": "Check: Data Integrity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 300]
    }
